rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(familyId) {
      return isSignedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/families/$(familyId)).data.memberUserIds;
    }

    // Bilety wpisane pod: families/{familyId}/trips/{tripId}/tickets/{fileName}
    match /families/{familyId}/trips/{tripId}/tickets/{fileName} {
      allow read: if isMember(familyId);
      allow write: if isMember(familyId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if isMember(familyId);
    }
  }
}
